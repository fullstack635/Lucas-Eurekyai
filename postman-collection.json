							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/lists?limit=20&offset=0&status=ACTIVE&isCompleted=false&orderBy=createdAt&orderDirection=desc&includeItems=true&itemsLimit=5",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"lists"
							],
							"query": [
								{
									"key": "limit",
