									"description": "Maximum number of lists to return"
								},
								{
									"key": "offset",
									"value": "0",
									"description": "Number of lists to skip for pagination"
								},
								{
									"key": "status",
									"value": "ACTIVE",
									"description": "Filter by list status (ACTIVE, COMPLETED, ARCHIVED, DELETED)"
								},
								{
									"key": "isCompleted",
									"value": "false",
									"description": "Filter by completion status (true/false)"
								},
								{
									"key": "orderBy",
									"value": "createdAt",
									"description": "Sort by field (name, createdAt, updatedAt, completedAt)"
								},
								{
									"key": "orderDirection",
									"value": "desc",
									"description": "Sort direction (asc/desc)"
								},
								{
									"key": "includeItems",
									"value": "true",
									"description": "Include list items in response (true/false)"
								},
								{
									"key": "itemsLimit",
									"value": "5",
									"description": "Maximum number of items per list when includeItems=true"
								}
