							"raw": "{\n  \"content\": \"Buy groceries\",\n  \"description\": \"Weekly grocery shopping\",\n  \"priority\": \"medium\",\n  \"order\": \"1\",\n  \"metadata\": {\n    \"category\": \"shopping\",\n    \"estimatedTime\": 60,\n    \"notes\": \"Don't forget milk and bread\"\n  }\n}"
